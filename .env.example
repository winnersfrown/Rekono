# Copy to .env and fill in as needed.

# Database. Defaults to a local SQLite file if unset.
# For production, point this at Postgres:
# DATABASE_URL=postgresql+psycopg2://rekono:rekono@localhost:5432/rekono
DATABASE_URL=sqlite:///./rekono.db

# Where uploaded/normalized documents are stored on disk.
STORAGE_DIR=./storage

# Anthropic API key for LLM-based structured extraction.
# If unset, Rekono falls back to a heuristic regex extractor so the
# pipeline still runs end-to-end for demos/tests without a key.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Below this overall confidence score (0-1), an invoice is flagged
# for human review instead of auto-approval.
REVIEW_CONFIDENCE_THRESHOLD=0.85

# Matching tolerances
MATCH_AMOUNT_TOLERANCE_PCT=0.02
MATCH_AMOUNT_TOLERANCE_ABS=5.00
MATCH_DATE_WINDOW_DAYS=5
MATCH_VENDOR_SCORE_THRESHOLD=80

# Copy to .env and fill in as needed.

# Database. Defaults to a local SQLite file if unset (path after "sqlite:").
# For production, point this at Postgres -- a free Neon project (neon.tech)
# works well since, unlike Render's own free Postgres, it doesn't auto-delete
# after 30 days. See README.md's "Database (Neon)" section.
# DATABASE_URL=postgresql://rekono:rekono@localhost:5432/rekono
DATABASE_URL=sqlite:./rekono.db

# Where uploaded/normalized documents are stored on disk.
STORAGE_DIR=./storage

# JWT signing secret. Leave unset for local dev -- Rekono will generate one
# and persist it to a file next to STORAGE_DIR on first run. Set this
# explicitly for any deployment with more than one instance/replica.
SECRET_KEY=

# --- LLM provider ---------------------------------------------------------
# Powers structured extraction, merchant categorization, the QuickBooks
# expense-account and bank-match suggestions, and Ask Rekono. With no
# provider configured, extraction falls back to a heuristic regex extractor
# and the AI-only features return "no suggestion", so the pipeline still
# runs end to end for demos/tests without any key.
#
# Two providers are supported; configure either one.

# 1) Gemini. Free key (no credit card) at https://aistudio.google.com.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 2) OpenRouter (https://openrouter.ai) -- one API in front of many
# providers' models. BOTH of these must be set: there's no default model,
# since slugs are specific and change as models come and go. Find the exact
# slug on the model's OpenRouter page (it looks like "vendor/model-name");
# models with a ":free" suffix cost nothing.
#
# The model MUST support tool/function calling -- extraction forces a JSON
# schema through it. One that doesn't will fail every extraction and fall
# back to the heuristic path.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional attribution headers OpenRouter uses for its public leaderboards.
# OPENROUTER_SITE_URL=https://winnersfrown.github.io/Rekono/
# OPENROUTER_APP_NAME=Rekono
#
# Where those OpenAI-dialect calls go. Defaults to OpenRouter. Nothing in
# the code path is OpenRouter-specific past the two headers above -- it's a
# plain POST /chat/completions with a bearer token -- so this also points at
# any other OpenAI-compatible endpoint: a self-hosted gateway (LiteLLM,
# OmniRoute), a local runtime (vLLM, Ollama, llama.cpp), or an Azure
# deployment. Give the base, WITHOUT /chat/completions on the end.
#
# The model must still support tool/function calling, and OPENROUTER_MODEL
# is still what names it -- whatever the endpoint calls that model.
#
# Read the "Self-hosted gateways" note in README.md before pointing this at
# a gateway you didn't write: it terminates your provider credentials and
# sees every prompt, which for this app means customer invoices.
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:20128/v1

# Which one to use when both are configured. Unset picks whichever has
# credentials, preferring OpenRouter.
# LLM_PROVIDER=openrouter

# Below this overall confidence score (0-1), an invoice is flagged
# for human review instead of auto-approval.
REVIEW_CONFIDENCE_THRESHOLD=0.85

# Matching tolerances
MATCH_AMOUNT_TOLERANCE_PCT=0.02
MATCH_AMOUNT_TOLERANCE_ABS=5.00
MATCH_DATE_WINDOW_DAYS=5
MATCH_VENDOR_SCORE_THRESHOLD=80

# Contact form (POST /api/contact -- the marketing site's "Talk to us"
# form), sent via Resend (resend.com). If unset, the endpoint responds 503
# and the marketing site falls back to a mailto: link automatically.
RESEND_API_KEY=
CONTACT_TO_EMAIL=wfrownusa@yahoo.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Billing (Stripe) -- powers the onboarding wizard's paid-plan step, plan
# changes, and the billing-management portal. If unset, those routes
# respond 503; the Free plan and everything else work regardless. Prices
# are built inline from plans.js at checkout time, so no Products/Prices
# need to be created by hand in the Stripe dashboard -- only an account and
# its keys. See README.md's "Plans & billing (Stripe)" section for the
# webhook setup.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# "Sign in with Google" (GET /api/auth/google). If unset, that route
# redirects back with an error instead of crashing; email/password sign-in
# and everything else work regardless. A Google account matched by verified
# email either logs in (existing account) or signs up (new org + user, same
# as a normal signup) -- no separate account-linking step. See README.md's
# "Sign in with Google" section for the Google Cloud Console setup.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# QuickBooks Online integration (Settings tab's "Integrations" panel). If
# unset, that panel shows "not set up yet" instead of a Connect button;
# everything else works regardless. Defaults to Intuit's Sandbox
# environment (no app-review needed) -- set QUICKBOOKS_ENVIRONMENT=production
# only once the Intuit app has passed production review. See README.md's
# "QuickBooks Online (Phase 1)" section for the Intuit Developer Portal setup.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox

# API-wide rate limits, per client IP per 15 minutes. Defaults suit a
# deployment where users come from different addresses. Raise them if
# everyone shares one NAT/VPN egress IP, since the whole office then spends
# a single budget. The tighter per-account limits on login, password change
# and the AI assistant aren't configurable -- those target specific abuse
# rather than capacity. See README.md's "Hardening" section.
# RATE_LIMIT_API_MAX=5000
# RATE_LIMIT_EXPENSIVE_MAX=300

# Rekono's own team, not a customer role -- gates the cross-org usage
# dashboard (GET /api/staff/overview, the "Staff" nav tab). Comma-separated
# email addresses, case-insensitive. Unset/empty means nobody can reach it,
# not even the first org's owner -- there's no signup flow that should ever
# be able to grant this. See README.md's "Staff / cross-org usage dashboard"
# section.
# STAFF_EMAILS=you@rekono.example,teammate@rekono.example

# Origins allowed to make cross-origin browser requests to this API (CORS).
# Comma-separated. Defaults to the marketing site + the app's own deployed
# origin + localhost for local dev -- override only if you've deployed this
# somewhere else. See README.md's "Hardening" section.
# ALLOWED_ORIGINS=https://winnersfrown.github.io,https://rekono-crv7.onrender.com,http://localhost:8000

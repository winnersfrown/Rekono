{"nodes": [{"id": "changelog_v1_67", "label": "v1.67: Auto-Reverse Accruals", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds auto_reverse flag to RecurringEntry so an accrual can un-post itself (mirror image dated the 1st of the following month) before the real bill/payroll lands, completing record-post-adjust-close-reverse."}, {"id": "changelog_v1_66", "label": "v1.66: Investor Demo Data", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Seeds real AR invoices, AP bills with discounts, payroll, equity events and income tax into the demo org so no accounting tab reads empty."}, {"id": "changelog_v1_65", "label": "v1.65: Bill Payment Totals Fix", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bill Payments list and detail view now count amount+discount instead of BillPayment.amountCents alone, matching the shared amountPaidCents logic."}, {"id": "changelog_v1_64", "label": "v1.64: Purchases/Cash Payments Journal Columns", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gives purchases/cash payments journals traditional specialized columns; recording a payment now takes an optional early-payment discount posted to a new Purchases Discounts Taken contra-expense account."}, {"id": "changelog_v1_63", "label": "v1.63: Journal Line Detail", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds a Doc # column and expandable line detail (account title, post ref, debit, credit) to every journal so it reads like a manual ledger."}, {"id": "changelog_v1_62", "label": "v1.62: Statement Drill-Down", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every account amount on trial balance/income statement/balance sheet is now a link into the posted journal lines that sum to it, reusing financialStatements.js's own logic so it can't drift."}, {"id": "changelog_v1_61", "label": "v1.61: Cash-Moving Equity/Tax Events", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Routes contributions, distributions, treasury moves, and tax payments into cash receipts/payments journals instead of the general journal, since anything that moves cash belongs there."}, {"id": "changelog_v1_60", "label": "v1.60: Command Palette", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds a faster, second navigation path (\u2318K) built from the nav's own [data-tab] buttons rather than a hand-maintained list, so nothing can drift out of sync."}, {"id": "changelog_v1_59", "label": "v1.59: Add-Account Form Split & Invoice Tab Merge", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two forms both claimed the name 'add an account' (net worth vs Chart of Accounts); splitting them and merging the Invoices upload/review tabs removes the switch instead of signposting it."}, {"id": "changelog_v1_58", "label": "v1.58: Hero/Ask-Rekono Craft Fixes", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Truncates account names instead of wrapping in the hero trial-balance workpaper; gives the floating Ask Rekono widget --shadow-modal since it's a genuinely floating layer per DESIGN.md's carve-out."}, {"id": "changelog_v1_57", "label": "v1.57: New Logomark", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the gradient-badge R with a ledger-cell mark closed by the two rules a statement ends on; white fill with ink outline holds shape at 16px."}, {"id": "changelog_v1_56", "label": "v1.56: Payroll & Special-Purpose Journals", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds manual Payroll posting, the four special-purpose journals as filters over Journal Entries, a third Chart of Accounts grouping level, and a real Add-an-account shortcut from Home."}, {"id": "changelog_v1_55", "label": "v1.55: Plaid Merchant-Name Matching Fix", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plaid's simplified merchant_name scored poorly on fuzzy vendor match; running the raw descriptor through normalizeMerchant keeps the brand name intact."}, {"id": "changelog_v1_54", "label": "v1.54: Plaid Bank Connections", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A Plaid-connected account rides the existing matching engine as a MatchSource rather than needing a second reconciliation path; credentials never touch the app."}, {"id": "changelog_v1_53", "label": "v1.53: Graphify Install & Vendor Payment Terms Fallback", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Installs the graphify knowledge-graph skill (2,016 nodes/5,178 edges first build) and fixes bills to inherit vendor.paymentTermsDays as a due-date fallback, same as customer invoices."}, {"id": "changelog_v1_52", "label": "v1.52: Scorecard Findings Closed", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fixes 5 open vulnerabilities via package overrides/vite upgrade, pins the Docker base image by digest, adds Dependabot/SECURITY.md/CI/CodeQL."}, {"id": "changelog_v1_51", "label": "v1.51: OpenSSF Scorecard Action", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Publishes weekly Scorecard results to the public API since a criticality score is checked by maintainer-eligibility criteria."}, {"id": "changelog_v1_50", "label": "v1.50: Check Writing", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "models/WrittenCheck.js posts through the exact same recordBillPayment path as Record Payment, kept as its own table since the OCR Check model's routes assume a scanned upload."}, {"id": "changelog_v1_49", "label": "v1.49: Fixed Asset Tracking", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "FixedAsset owns one RecurringEntry; accumulated depreciation is computed from what's actually posted, not schedule math, so nothing claims depreciation that hasn't happened."}, {"id": "changelog_v1_48", "label": "v1.48: Chart of Accounts Subtype Taxonomy", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "accountTaxonomy.js defines a canonical subtype list per account type, served at GET /api/accounts/subtypes, surfaced as a Category picker and Current/Fixed/Long-term grouping."}, {"id": "changelog_v1_47", "label": "v1.47: Standing Commit/PR Authorization", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CLAUDE.md's shipping section no longer waits for per-task go-ahead on commit/PR, carving out destructive git operations as still needing sign-off."}, {"id": "changelog_v1_46", "label": "v1.46: LICENSE Fix", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the contradictory BSD 2-Clause LICENSE with an all-rights-reserved notice matching package.json's UNLICENSED declaration."}, {"id": "changelog_v1_45", "label": "v1.45: Check Scanning & Correction-Save Fix", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds a sixth document pipeline (checks) that applies to bills via accountsPayable.js's recordBillPayment; fixes saveCorrections to report failure instead of silently blanking the form."}, {"id": "changelog_v1_44", "label": "v1.44: Spelled-Out PO Label Fix", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Heuristic extractor now recognizes 'Purchase Order Number' spelled out, not just 'PO', excluding a vendor's own PO Box address."}, {"id": "changelog_v1_43", "label": "v1.43: Vendor Early-Payment Discount Terms", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Vendor gains earlyPayDiscountPct/Days; AP Aging computes what's still available to save, anchored to invoice date and outstanding balance."}, {"id": "changelog_v1_42", "label": "v1.42: Configurable OpenAI-Compatible Endpoint", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "OPENAI_COMPATIBLE_BASE_URL makes the adapter point at any self-hosted gateway/local runtime instead of hardcoding OpenRouter's URL."}, {"id": "changelog_v1_41", "label": "v1.41: Product/Marketing Width Remodel", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Moves the 760px cap off .panel onto field columns so tables/schedules take the full page width; applies the --sp-* spacing scale to the product stylesheet."}, {"id": "changelog_v1_40", "label": "v1.40: Chart of Accounts & Nav Organization", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Balance sheet accounts sort by liquidity, income statement accounts by creation order; top-bar menus gain section headings (Ledger/Statements/Equity, etc.)."}, {"id": "changelog_v1_39", "label": "v1.39: Full Invoice Charge Schema", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds shipping, discount and other_charges fields so the confidence cross-check (subtotal+charges-discount+tax=total) no longer fails invoices with a shipping line."}, {"id": "changelog_v1_38", "label": "v1.38: Multi-Step Income Statement & Demo Ledger", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separates cost of revenue from operating expenses so gross profit and operating income answer different questions; seedDemoOrg now seeds six months of real ledger activity."}, {"id": "changelog_v1_37", "label": "v1.37: Revert to Bitter/Blue Palette", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reverts v1.36's oxblood skin back to Bitter/blue while keeping the ruled-panel structure; adds --accent-ink as a third accent token to fix a contrast bug on the light accent."}, {"id": "changelog_v1_36", "label": "v1.36: Workpaper Visual Identity Redesign", "file_type": "rationale", "source_file": "CHANGELOG.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Design toward the workpaper, not the wallet': warm paper, oxblood, Fraunces/Geist/Geist Mono, hairline rules instead of shadows, right-aligned money with double-ruled totals -- because Rekono's differentiator is refusing to guess, not ease."}, {"id": "changelog_v1_35", "label": "v1.35: Close automation surfaces missing recurring expenses and undepreciated assets", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": "lines 1109-1166", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog_v1_34", "label": "v1.34: Income tax provision, computed circularity-safe, and pre-tax income shown on the P&L", "file_type": "document", "source_file": "CHANGELOG.md", "source_location": "lines 1168-1232", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "changelog_v1_33", "label": "v1.33: Stock comp